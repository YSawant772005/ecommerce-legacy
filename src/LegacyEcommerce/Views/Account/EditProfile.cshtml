@model LegacyEcommerce.Models.ViewModels.EditProfileViewModel
@{
    ViewBag.Title = "Edit Profile";
}
<div class="container">
    <nav class="breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span>
        <a href="@Url.Action("Index", "Account")">My Account</a><span class="sep">/</span><span>Edit Profile</span>
    </nav>

    <div class="account-layout">
        @Html.Partial("_AccountSidebar", (LegacyEcommerce.Models.User)ViewData["User"])

        <div class="account-main">
            @using (Html.BeginForm("EditProfile", "Account", FormMethod.Post, new { @class = "checkout-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "field-error summary-error" })

                <div class="step-card">
                    <div class="step-head"><span class="step-no">&#9672;</span><h3>Profile details</h3></div>
                    <div class="form-grid">
                        <div class="field full">
                            @Html.LabelFor(m => m.FullName, "Full name")
                            @Html.TextBoxFor(m => m.FullName, new { placeholder = "Your name" })
                            @Html.ValidationMessageFor(m => m.FullName)
                        </div>
                        <div class="field">
                            @Html.LabelFor(m => m.Email, "Email")
                            @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "you@example.com" })
                            @Html.ValidationMessageFor(m => m.Email)
                        </div>
                        <div class="field">
                            @Html.LabelFor(m => m.Phone, "Phone")
                            @Html.TextBoxFor(m => m.Phone, new { placeholder = "10-digit mobile number" })
                            @Html.ValidationMessageFor(m => m.Phone)
                        </div>
                    </div>
                </div>

                <div class="success-actions">
                    <a class="btn btn-ghost" href="@Url.Action("Index", "Account")">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            }
        </div>
    </div>
</div>
@{
    ViewBag.Title = "Check Your Email";
    var resetLink = ViewBag.ResetLink as string;
    var submitted = ViewBag.SubmittedEmail as string;
}

<div class="container auth-wrap">
    <div class="auth-card">
        <div class="auth-art">
            <h2>Check your inbox</h2>
            <p>If an account exists for the email you entered, a password reset link is on its way.</p>
            <ul>
                <li>Link expires in 30 minutes</li>
                <li>Check your spam folder if you don't see it</li>
                <li>You can request a new link any time</li>
            </ul>
        </div>

        <div class="auth-form">
            <h1>Reset link sent</h1>
            <p class="muted">We sent a reset link to <b>@submitted</b>. Open it to choose a new password.</p>

            @if (resetLink != null)
            {
                <div class="mock-note">
                    <b>Development mode</b>
                    <p>No email server is configured in this environment, so open the link directly:</p>
                    <p><a href="@resetLink">@resetLink</a></p>
                </div>
            }

            <div class="auth-alt">
                <a href="@Url.Action("ForgotPassword", "Account")">Resend link</a> &middot;
                <a href="@Url.Action("Login", "Account")">Back to sign in</a>
            </div>
        </div>
    </div>
</div>

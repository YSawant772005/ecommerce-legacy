@model LegacyEcommerce.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
}

<div class="container auth-wrap">
    <div class="auth-card">
        <div class="auth-art">
            <h2>Recover your account</h2>
            <p>Enter the email you signed up with and we'll send you a secure link to set a new password.</p>
            <ul>
                <li>Link expires in 30 minutes</li>
                <li>Works without signing in</li>
                <li>Your old password stays unchanged until you confirm</li>
            </ul>
        </div>

        <div class="auth-form">
            <h1>Forgot password?</h1>
            <p class="muted">We'll email you a reset link.</p>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "stack-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "field-error summary-error" })

                <div class="field">
                    @Html.LabelFor(m => m.Email, "Email address")
                    @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "you@example.com", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Email)
                </div>

                <button class="btn btn-accent full" type="submit">Send reset link</button>

                <div class="auth-alt">
                    Remembered it? <a href="@Url.Action("Login", "Account")">Back to sign in</a>
                </div>
            }
        </div>
    </div>
</div>

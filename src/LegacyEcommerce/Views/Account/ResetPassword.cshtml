@model LegacyEcommerce.Models.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
}

<div class="container auth-wrap">
    <div class="auth-card">
        <div class="auth-art">
            <h2>Choose a new password</h2>
            <p>Pick something strong you haven't used on NovaKart before.</p>
            <ul>
                <li>At least 6 characters</li>
                <li>Link can be used only once</li>
                <li>You'll sign in with the new password right after</li>
            </ul>
        </div>

        <div class="auth-form">
            <h1>Reset password</h1>
            <p class="muted">Enter and confirm your new password.</p>

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "stack-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Token)
                @Html.ValidationSummary(true, "", new { @class = "field-error summary-error" })

                <div class="field">
                    @Html.LabelFor(m => m.NewPassword, "New password")
                    @Html.TextBoxFor(m => m.NewPassword, new { type = "password", placeholder = "At least 6 characters", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.NewPassword)
                </div>

                <div class="field">
                    @Html.LabelFor(m => m.ConfirmPassword, "Confirm password")
                    @Html.TextBoxFor(m => m.ConfirmPassword, new { type = "password", placeholder = "Repeat new password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword)
                </div>

                <button class="btn btn-accent full" type="submit">Reset password</button>

                <div class="auth-alt">
                    <a href="@Url.Action("Login", "Account")">Back to sign in</a>
                </div>
            }
        </div>
    </div>
</div>

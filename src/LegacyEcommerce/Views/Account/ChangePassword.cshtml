@model LegacyEcommerce.Models.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}
<div class="container">
    <nav class="breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span>
        <a href="@Url.Action("Index", "Account")">My Account</a><span class="sep">/</span><span>Change Password</span>
    </nav>

    <div class="account-layout">
        @Html.Partial("_AccountSidebar", (LegacyEcommerce.Models.User)ViewData["User"])

        <div class="account-main">
            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "checkout-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "field-error summary-error" })

                <div class="step-card" style="max-width:520px;">
                    <div class="step-head"><span class="step-no">&#9919;</span><h3>Update password</h3></div>
                    <div class="form-grid">
                        <div class="field full">
                            @Html.LabelFor(m => m.CurrentPassword, "Current password")
                            @Html.PasswordFor(m => m.CurrentPassword, new { placeholder = "Your current password" })
                            @Html.ValidationMessageFor(m => m.CurrentPassword)
                        </div>
                        <div class="field">
                            @Html.LabelFor(m => m.NewPassword, "New password")
                            @Html.PasswordFor(m => m.NewPassword, new { placeholder = "At least 6 characters" })
                            @Html.ValidationMessageFor(m => m.NewPassword)
                        </div>
                        <div class="field">
                            @Html.LabelFor(m => m.ConfirmPassword, "Confirm new password")
                            @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Re-enter your new password" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword)
                        </div>
                    </div>
                </div>

                <div class="success-actions">
                    <a class="btn btn-ghost" href="@Url.Action("Index", "Account")">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update password</button>
                </div>
            }
        </div>
    </div>
</div>
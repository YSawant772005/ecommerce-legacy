@model List<LegacyEcommerce.Models.Product>
@{
    ViewBag.Title = "My Wishlist";
}

<div class="container">
    <nav class="breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span><span>Wishlist</span>
    </nav>

    <div class="page-head">
        <div>
            <h1>My Wishlist</h1>
            <div class="count">@Model.Count saved item@(Model.Count == 1 ? "" : "s")</div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="results-empty">
            <b>Your wishlist is empty</b>
            Tap the heart on any product to save it for later.
            <div style="margin-top:18px;">
                <a class="btn btn-primary" href="@Url.Action("Index", "Products")">Browse products</a>
            </div>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    }
</div>
